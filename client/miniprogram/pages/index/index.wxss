.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 24rpx;
}

.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
}

.input {
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  background-color: #f9fafb;
}

.input:focus {
  border-color: #2563eb;
  background-color: #ffffff;
}

.error {
  color: #ef4444;
  font-size: 26rpx;
}

.submit {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
}

.submit[disabled] {
  background-color: #d1d5db;
  color: #6b7280;
}

.hint {
  font-size: 26rpx;
  color: #6b7280;
}

.status {
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.status.success {
  background-color: #ecfdf5;
  color: #065f46;
}

.status.error {
  background-color: #fef2f2;
  color: #991b1b;
}
