<view class="container">
  <view class="card">
    <view class="title">请求邮箱验证码</view>
    <view class="status-area">
      <view class="status {{statusLevel}}">{{statusText}}</view>
    </view>
    <input
      class="input"
      type="text"
      placeholder="请输入邮箱"
      value="{{email}}"
      bindinput="onEmailInput"
      disabled="{{loading}}"
    />
    <view class="error" wx:if="{{email && !emailValid}}">邮箱格式不正确</view>
    <button
      class="submit"
      type="primary"
      bindtap="onGetCodeTap"
      disabled="{{!emailValid || !socketOpen || loading}}"
    >{{loading ? '发送中…' : '获取验证码'}}</button>
    <view class="hint">通过 WebSocket 提交邮箱，后端会返回验证码发送结果。</view>
  </view>
</view>
