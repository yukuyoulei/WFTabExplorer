<view class="container">
  <view class="card">
    <view class="title">请求邮箱验证码</view>
    <input
      class="input"
      type="text"
      placeholder="请输入邮箱地址"
      value="{{email}}"
      bindinput="onEmailInput"
    />
    <view class="error" wx:if="{{email && !isEmailValid}}">邮箱格式不正确</view>
    <button
      class="submit"
      type="primary"
      bindtap="onRequestCode"
      disabled="{{!isEmailValid || sending}}"
    >{{sending ? '发送中…' : '获取验证码'}}</button>
    <view class="hint">通过 WebSocket 将邮箱发送至后端，后端会返回模拟的验证码发送结果。</view>
  </view>
  <view class="status success" wx:if="{{statusType === 'success'}}">{{statusMessage}}</view>
  <view class="status error" wx:if="{{statusType === 'error'}}">{{statusMessage}}</view>
</view>
